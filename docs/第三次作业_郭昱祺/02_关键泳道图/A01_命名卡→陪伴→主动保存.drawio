Color=#EBCBD8;spacing=10;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="329.0" y="705" width="214" height="88" /></mxCell><mxCell id="pick" value="选择要保存的快照&#10;未登录先登录并重确认" style="html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#342B33;fillColor=#F9EAF0;strokeColor=#EBCBD8;spacing=10;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="65.0" y="810" width="214" height="88" /></mxCell><mxCell id="save" value="预览范围并确认SAVE&#10;取消则无持久写" style="html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#342B33;fillColor=#F9EAF0;strokeColor=#EBCBD8;spacing=10;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="329.0" y="925" width="214" height="88" /></mxCell><mxCell id="write" value="事务写记录与授权&#10;幂等回执／对象版本" style="html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#342B33;fillColor=#E8F3EC;strokeColor=#EBCBD8;spacing=10;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="857.0" y="1035" width="214" height="88" /></mxCell><mxCell id="result" value="写入结果明确？" style="html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#342B33;fillColor=#FFF2D8;strokeColor=#EBCBD8;spacing=10;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.0" y="1140" width="180" height="98" /></mxCell><mxCell id="ok" value="确认成功才显示已保存&#10;END只清临时会话" style="html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#342B33;fillColor=#E8F3EC;strokeColor=#EBCBD8;spacing=10;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="329.0" y="1280" width="214" height="88" /></mxCell><mxCell id="okEnd" value="" style="html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#342B33;fillColor=#F9EAF0;strokeColor=#EBCBD8;spacing=10;ellipse;doubleEllipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="425" y="1395" width="22" height="22" /></mxCell><mxCell id="cancel" value="取消许可／保存&#10;不