tml=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#342B33;fillColor=#F9EAF0;strokeColor=#EBCBD8;spacing=10;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="593.0" y="445" width="214" height="88" /></mxCell><mxCell id="db" value="注册：创建账号&#10;登录：写登录会话／轮换" style="html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#342B33;fillColor=#E8F3EC;strokeColor=#EBCBD8;spacing=10;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="857.0" y="565" width="214" height="88" /></mxCell><mxCell id="result" value="成功的操作？" style="html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#342B33;fillColor=#FFF2D8;strokeColor=#EBCBD8;spacing=10;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="610.0" y="695" width="180" height="100" /></mxCell><mxCell id="registered" value="201注册成功&#10;提示另行登录，不建身份" style="html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#342B33;fillColor=#F9EAF0;strokeColor=#EBCBD8;spacing=10;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="329.0" y="810" width="214" height="88" /></mxCell><mxCell id="clean" value="登录成功：重建当前身份&#10;清旧临时正文与任务&#10;不自动认领游客内容" style="html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#342B33;fillColor=#F9EAF0;strokeColor=#EBCBD8;spacing=10;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="329.0" y="955" width="214" height="108" /></mxCell><mxCell id="ok" value="注册后：去登录&#10;登录后：进本人私密主页" style="html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#342B33;fillColor=#E8F3EC;strokeColor=#EBCBD8;spacing=10;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="329.0" y="1190" width="214" height="88" /></mxCell><mxCell id="okEnd" value="" style="html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#342B33;fillColor=#F9EAF0;strokeColor=#EBCBD8;spacing=10;ellipse;doubleEllipse;" vertex="1" paren