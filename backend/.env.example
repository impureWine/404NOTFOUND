PORT=3000
DATABASE_URL=postgresql://app_user:change-me@127.0.0.1:5432/404notfound
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=2000
DATABASE_CONNECT_TIMEOUT_MS=3000
SEARCH_PROVIDER=wikipedia
SEARCH_TIMEOUT_MS=5000
SEARCH_LANGUAGE=zh
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_TIMEOUT_MS=30000
INTERNAL_MODEL_TOKEN=
APP_ORIGIN=http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
MIGRATE_ON_START=false
PROFILE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Trusted entry identity is configured by the server, never by request bodies.
APP_ENTRY_POINT=WEB
# Serve the built frontend from this backend when true; set APP_ORIGIN accordingly.
APP_SERVE_FRONTEND=false
# Optional WeChat official-account callback. Configure only in local/deployment secrets.
WECHAT_TOKEN=
WECHAT_APP_ID=
WECHAT_ENCODING_AES_KEY=
WECHAT_WEB_URL=
