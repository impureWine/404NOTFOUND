erDiagram
    USER_ACCOUNTS ||--|| PASSWORD_CREDENTIALS : authenticates_with
    USER_ACCOUNTS ||--|| USER_PROFILES : owns
    USER_ACCOUNTS ||--|| ACCOUNT_PREFERENCES : configures
    USER_ACCOUNTS ||--o{ LOGIN_SESSIONS : creates
    ENTRY_POINTS ||--o{ LOGIN_SESSIONS : accepts
    USER_ACCOUNTS ||--o{ CONSENT_GRANTS : grants
    ENTRY_POINTS ||--o{ CONSENT_GRANTS : scopes
    USER_ACCOUNTS ||--o{ SAVED_RECORDS : owns
    ENTRY_POINTS ||--o{ SAVED_RECORDS : scopes
    SAVED_RECORDS ||--o{ SAVED_MESSAGES : contains
    SAVED_RECORDS ||--o| EMOTION_RECORDS : specializes
    SAVED_RECORDS ||--o| WORRY_OBJECTS : specializes
    SAVED_RECORDS ||--o| REHEARSAL_DRAFTS : specializes
    SAVED_RECORDS ||--o| WORRY_DEPOSITS : specializes
    SAVED_RECORDS ||--o| SAVED_QUERIES : specializes
    WORRY_OBJECTS ||--o{ ROOM_OBJECTS : appears_as
    SAVED_QUERIES ||--o{ CLAIMS : contains
    CLAIMS ||--o{ EVIDENCE_LINKS : supported_by
    SOURCES ||--o{ EVIDENCE_LINKS : cited_by
    USER_ACCOUNTS ||--o{ DELETION_JOBS : requests
    DELETION_JOBS ||--o{ DELETION_TARGETS : fans_out
    DELETION_JOBS ||--|| DELETION_OUTBOX : emits
    DELETION_JOBS ||--o{ DELETION_LOG_ENTRIES : records
    USER_ACCOUNTS ||--o{ AUDIT_EVENTS : acts

    USER_ACCOUNTS {
      uuid id PK
      varchar login_identifier_normalized UK
      account_status status
      timestamptz created_at
    }
    PASSWORD_CREDENTIALS {
      uuid id PK
      uuid account_id FK
      varchar password_digest
      varchar algorithm
      jsonb parameters
    }
    USER_PROFILES {
      uuid id PK
      uuid account_id FK
      varchar nickname
      bytea bio_ciphertext
    }
    ACCOUNT_PREFERENCES {
      uuid id PK
      uuid account_id FK
      jsonb preferences
    }
    ENTRY_POINTS {
      uuid id PK
      varchar code UK
      jsonb capability_state
    }
    LOGIN_SESSIONS {
      uuid id PK
      uuid account_id FK
      uuid entry_point_id FK
      bytea token_digest UK
      timestamptz expires_at
      timestamptz revoked_at
    }
    CONSENT_GRANTS {
      uuid id PK
      uuid account_id FK
      uuid source_entry_point_id FK
      uuid target_entry_point_id FK
      consent_purpose purpose
      jsonb scope
    }
    SAVED_RECORDS {
      uuid id PK
      uuid account_id FK
      uuid entry_point_id FK
      saved_record_kind record_kind
      varchar request_id
      int version_no
      timestamptz deleted_at
    }
    SAVED_MESSAGES {
      uuid id PK
      uuid saved_record_id FK
      int sequence_no
      message_role role
      bytea content_ciphertext
    }
    EMOTION_RECORDS {
      uuid saved_record_id PK, FK
      date record_date
      varchar emotion_code
      smallint intensity
    }
    WORRY_OBJECTS {
      uuid saved_record_id PK, FK
      varchar shape_code
      bytea title_ciphertext
      bytea body_ciphertext
    }
    ROOM_OBJECTS {
      uuid id PK
      uuid account_id FK
      uuid entry_point_id FK
      uuid worry_object_id FK
      jsonb position_state
    }
    REHEARSAL_DRAFTS {
      uuid saved_record_id PK, FK
      bytea expression_ciphertext
    }
    WORRY_DEPOSITS {
      uuid saved_record_id PK, FK
      bytea body_ciphertext
      timestamptz reopen_at
      worry_deposit_status status
    }
    SAVED_QUERIES {
      uuid saved_record_id PK, FK
      bytea raw_query_ciphertext
      saved_query_status status
      varchar trace_id
    }
    SOURCES {
      uuid id PK
      varchar canonical_url UK
      varchar source_tier
      timestamptz retrieved_at
    }
    CLAIMS {
      uuid id PK
      uuid saved_query_id FK
      bytea claim_text_ciphertext
      varchar status
    }
    EVIDENCE_LINKS {
      uuid claim_id PK, FK
      uuid source_id PK, FK
      varchar relation
    }
    DELETION_JOBS {
      uuid id PK
      uuid account_id FK
      varchar request_id
      deletion_status status
    }
    DELETION_TARGETS {
      uuid id PK
      uuid deletion_job_id FK
      varchar target_kind
      deletion_status status
    }
    DELETION_OUTBOX {
      uuid id PK
      uuid deletion_job_id FK
      jsonb payload
      timestamptz published_at
    }
    DELETION_LOG_ENTRIES {
      uuid id PK
      uuid deletion_job_id
      varchar object_ref
      timestamptz retain_until
    }
    RETENTION_POLICIES {
      uuid id PK
      varchar data_class UK
      int retention_days
      int backup_grace_days
    }
    AUDIT_EVENTS {
      uuid id PK
      uuid actor_account_id FK
      uuid entry_point_id FK
      varchar event_code
      timestamptz occurred_at
    }
